# venv
.venv/
venv/
env/

# environment secrets
.env

# runtime artifacts
.cache/
runs/*.json
output/*.xlsx
output/*.csv
output/*.json

# run database (may hold scraped page text) and backend choice
data/
storage.json

# locally edited system prompts (defaults live in pipeline/prompts.py)
prompts.json
*.db
*.db-wal
*.db-shm

# python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/

# streamlit (theme config is committed; keep the rest ignored)
.streamlit/*
!.streamlit/config.toml

# editor
.idea/
.vscode/
*.swp
*.swo

# temp test scripts (out of tree)
# temp scripts under %TEMP% are already excluded by path

# keep this file so the dirs exist for first-time setup
!.gitkeep
