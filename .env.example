# Copy to .env and fill in. Everything here can also be set in the sidebar.

# --- Model ---
LLM_PROVIDER=openai              # openai | anthropic | deepseek | ollama
LLM_MODEL=gpt-4o-mini            # deepseek-chat if LLM_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=8000       # too low truncates the JSON and the call fails
LLM_CONCURRENCY=4
RECONCILE_BATCH_SIZE=6           # fields merged per call

# --- Scraping ---
SCRAPE_CONCURRENCY=4
PAGE_TIMEOUT_MS=60000
SETTLE_DELAY_S=2.5               # wait after load; client-rendered pricing needs this
MAX_SCRAPE_CHARS=40000
THIN_CONTENT_CHARS=600           # below this, retry with the static fetcher

# --- Behaviour ---
USE_CACHE=1                      # 0 disables the page and LLM caches
