# Copy to .env and fill in. Everything here can also be set in the sidebar.

# --- Model ---
LLM_PROVIDER=deepseek            # openai | anthropic | deepseek | ollama
LLM_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=8000       # too low truncates the JSON and the call fails
LLM_CONCURRENCY=4
RECONCILE_BATCH_SIZE=6           # fields merged per call

# --- Scraping ---
SCRAPE_CONCURRENCY=4
PAGE_TIMEOUT_MS=60000
SETTLE_DELAY_S=2.5               # wait after load; client-rendered pricing needs this
MAX_SCRAPE_CHARS=40000
THIN_CONTENT_CHARS=600           # below this, retry with the static fetcher

# --- ScrapeOps proxy fallback ---
# Only used when our own fetchers are blocked, plus up front for Reddit.
SCRAPEOPS_API_KEY=
SCRAPEOPS_ENABLED=1
SCRAPEOPS_RENDER_JS=1            # render in their browser; costs more credits
SCRAPEOPS_RESIDENTIAL_RETRY=1    # escalate to residential IPs, then anti-bot bypass
SCRAPEOPS_COUNTRY=us             # exit IP country; blank lets ScrapeOps choose
SCRAPEOPS_WAIT_MS=3000           # settle time after load when rendering JS

# --- Authentication ---
# Leave blank to leave the app open (no login screen).  Set AUTH_PASSWORD to require a
# single account, or AUTH_USERS for several: "alice:secret1,bob:secret2".
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_USERS=

# --- Behaviour ---
USE_CACHE=1                      # 0 disables the page and LLM caches
